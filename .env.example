# =============================================================================
# Painel Vamo Nessa — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha. .env.local é ignorado pelo git
# e NUNCA deve ser commitado nem colado em chat.
#
# Regra: só as variáveis com prefixo NEXT_PUBLIC_ chegam ao navegador.
# Todas as outras existem exclusivamente no servidor.
# =============================================================================


# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------

# URL pública, SEM barra no final — a Meta compara o redirect_uri caractere a
# caractere, e uma barra sobrando causa "invalid redirect_uri".
# É a base do OAuth Redirect URI e do Webhook Callback URL cadastrados na Meta.
#
#   Produção:        https://vamonessasp.vercel.app
#   Desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Fuso horário canônico do produto. Não alterar.
APP_TIMEZONE=America/Sao_Paulo


# -----------------------------------------------------------------------------
# META / INSTAGRAM
# Onde: developers.facebook.com/apps → seu app → Configurações → Básico
# -----------------------------------------------------------------------------

# "ID do aplicativo". Público, mas mantido server-side por hábito.
META_APP_ID=

# "Chave secreta do aplicativo" (botão Mostrar).
# SEGREDO. Assina a validação dos webhooks. Nunca expor.
META_APP_SECRET=

# Versão da Graph API a fixar. Atual em 17/08/2026: v26.0
META_API_VERSION=v26.0

# Os escopos do OAuth ficam em lib/env.ts (META_SCOPES), não aqui: não são
# segredo nem variam por ambiente, e mantê-los em env fazia o deploy rodar com
# valor antigo enquanto o repositório já estava correto.

# TEMPORÁRIO — SOMENTE DESENVOLVIMENTO LOCAL.
#
# O token de acesso definitivo NÃO mora em variável de ambiente: ele vem do
# fluxo OAuth e é gravado criptografado em instagram_accounts.access_token_encrypted.
# Esta variável existe apenas para sondar a API antes de o OAuth existir, e
# deve ser apagada assim que a conexão pelo painel funcionar.
#
# Onde obter: App Dashboard → Instagram → Configuração da API com login do
# Instagram → "Gerar token" para a conta conectada.
#
# NUNCA cadastre esta variável na Vercel nem em qualquer ambiente de produção.
META_DEV_ACCESS_TOKEN=

# TEMPORÁRIO — somente local. Token de USUÁRIO do Facebook, usado apenas para
# comparar Instagram Login x Facebook Login. Ver scripts/compare-logins.py.
META_DEV_FB_USER_TOKEN=


# -----------------------------------------------------------------------------
# SUPABASE
# Onde: supabase.com/dashboard → seu projeto → Project Settings → API
# -----------------------------------------------------------------------------

# "Project URL". Público.
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon" / publishable. Público, protegido por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" / secret.
# SEGREDO MÁXIMO: ignora toda a RLS. Somente server-side.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# SEGREDOS GERADOS LOCALMENTE
# Gere você mesmo, não precisa pedir a ninguém:
#   openssl rand -base64 32
# -----------------------------------------------------------------------------

# String que a Meta devolve no handshake GET do webhook. Você a inventa aqui e
# cadastra igual no App Dashboard, campo "Verificar token".
META_WEBHOOK_VERIFY_TOKEN=

# Protege os endpoints /api/cron/*. Enviado no header x-cron-secret pelo
# agendador (pg_cron do Supabase).
CRON_SECRET=

# Chave AES-256-GCM que criptografa o access token do Instagram em repouso.
# Precisa ser exatamente 32 bytes em base64.
# ATENÇÃO: se você perder ou trocar esta chave, o token salvo torna-se
# indecifrável e será necessário reconectar o Instagram.
TOKEN_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# ACESSO AO PAINEL
# -----------------------------------------------------------------------------

# E-mails autorizados a entrar, separados por vírgula.
# Usados para semear a tabela app_users.
ALLOWED_EMAILS=

# Senha do Postgres. Usada SOMENTE para aplicar migrations localmente
# (supabase db push). Não é usada em runtime e não vai para a Vercel.
# Onde: Supabase → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# ID da conta profissional do Instagram que o painel administra.
# Elimina a ambiguidade quando o usuário administra várias Páginas com Instagram
# vinculado — o OAuth recusa conectar em vez de escolher a errada.
META_TARGET_IG_USER_ID=

# Código de acesso ao painel. Tranca provisória até o Supabase Auth entrar:
# abrir /entrar?code=<valor> uma vez libera o navegador por 30 dias.
PANEL_ACCESS_CODE=

# -----------------------------------------------------------------------------
# IA — classificação de comentários e geração de respostas
# Onde: console.anthropic.com → API Keys
# -----------------------------------------------------------------------------

# SEGREDO. Sem ela o job de análise não roda; TODO o resto do sistema funciona.
ANTHROPIC_API_KEY=
